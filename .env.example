# Vision — main HUD's screen-capture pipeline (Gemini Flash captions).
# Without this, the HUD's "watching now" feed stays empty.
GEMINI_API_KEY=

# Memory layer — Hyperspell. Without these the HUD still boots but nothing
# is persisted to memory. With them, every screen caption + voice utterance
# auto-mirrors to both the partner vault and the firm vault.
HYPERSPELL_API_KEY=
HYPERSPELL_BASE=https://api.hyperspell.com
HYPERSPELL_USER_ID=hardik

# For local dev without a real Hyperspell account:
#   HYPERSPELL_BASE=mock://local
# (in-memory token-overlap store; loses everything on restart)

# Firm + partner identity — only matters once the memory layer is enabled.
SHADOW_FIRM_ID=acme_vc
SHADOW_FIRM_NAME=Acme Ventures
SHADOW_PARTNER_ID=hardik
SHADOW_PARTNER_NAME=You

# World knowledge — Nia. Optional. Without this, action cards (IC memo,
# sourcing sheet, etc.) render with "limited external data" tag.
NIA_API_KEY=
NIA_BASE=https://apigcp.trynia.ai/v2

# LLM synthesis for action cards. Optional — without it action handlers
# return stub JSON instead of real artifacts.
ANTHROPIC_API_KEY=
