# Required — Shadow refuses to boot without these.
HYPERSPELL_API_KEY=
HYPERSPELL_BASE=https://api.hyperspell.com
HYPERSPELL_USER_ID=hardik

# For local dev without a real Hyperspell account, set:
#   HYPERSPELL_BASE=mock://local
# (in-memory token-overlap store; loses everything on restart)

# Optional — Nia world-knowledge corpora for action cards.
# Disabled if NIA_API_KEY or NIA_BASE missing. Cards still render with "limited external data" tag.
NIA_API_KEY=
NIA_BASE=https://api.trynia.ai
NIA_CORPORA=companies:CORPUS_ID_HERE,news:CORPUS_ID_HERE,people:CORPUS_ID_HERE

# Optional — Anthropic for vision captions + LLM synthesis.
# Disabled if missing: screen captions become "screen content (vision disabled)" and action cards return stub objects.
ANTHROPIC_API_KEY=

# Optional model overrides
# SHADOW_VISION_MODEL=claude-haiku-4-5
# SHADOW_SUGGEST_MODEL=claude-haiku-4-5
# SHADOW_SYNTH_MODEL=claude-sonnet-4-5

# Optional capture tuning (ms)
# SHADOW_SCREEN_INTERVAL_MS=3000
# SHADOW_DWELL_REFRESH_MS=30000
# SHADOW_SUGGESTION_TTL_MS=60000
